		<quartz2.version>3.0.0-M4</quartz2.version>
		<log4j.version>2.17.2</log4j.version>
	</properties>
	
	<!-- BOM ensures consistent versions -->
	  <dependencyManagement>
		<dependencies>
		  <dependency>
			<groupId>org.openrewrite</groupId>
			<artifactId>rewrite-bom</artifactId>
			<version>8.74.3</version>
			<type>pom</type>
			<scope>import</scope>
		  </dependency>
		</dependencies>
	  </dependencyManagement>

	<dependencies>

	
		<!-- https://mvnrepository.com/artifact/org.apache.camel/camel-core-starter -->
